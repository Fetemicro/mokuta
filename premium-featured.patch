*** Add File: supabase/premium-featured.sql
+ALTER TABLE listings
+  ADD COLUMN IF NOT EXISTS is_featured boolean NOT NULL DEFAULT false,
+  ADD COLUMN IF NOT EXISTS featured_plan text NULL,
+  ADD COLUMN IF NOT EXISTS featured_price numeric(12,2) NULL,
+  ADD COLUMN IF NOT EXISTS featured_until timestamptz NULL;
+
+CREATE INDEX IF NOT EXISTS idx_listings_featured
+  ON listings (is_featured, featured_until);
+
+CREATE OR REPLACE FUNCTION enforce_featured_rules()
+RETURNS trigger AS $$
+BEGIN
+  IF NEW.is_featured = true THEN
+    IF NEW.status IS DISTINCT FROM 'approved' THEN
+      RAISE EXCEPTION 'Only approved listings can be featured';
+    END IF;
+
+    IF NEW.featured_until IS NULL THEN
+      RAISE EXCEPTION 'featured_until is required when is_featured is true';
+    END IF;
+  END IF;
+
+  IF NEW.is_featured = false THEN
+    NEW.featured_plan := NULL;
+    NEW.featured_price := NULL;
+    NEW.featured_until := NULL;
+  END IF;
+
+  RETURN NEW;
+END;
+$$ LANGUAGE plpgsql;
+
+DROP TRIGGER IF EXISTS listings_featured_rules ON listings;
+
+CREATE TRIGGER listings_featured_rules
+BEFORE INSERT OR UPDATE OF status, is_featured, featured_plan, featured_price, featured_until
+ON listings
+FOR EACH ROW
+EXECUTE FUNCTION enforce_featured_rules();
